# Copy to .env (git-ignored) and adjust. Every value is optional; the defaults run on the demo emails
# with the rule-based baseline (no AI, no Google account, no cost).

# --- Inbox source ---------------------------------------------------------------
# fixture = local demo .eml files (default)
# gmail   = your dedicated Gmail TEST account, read-only (see docs/GMAIL_SETUP.md)
INBOX_MODE=fixture

# --- Interpretation -------------------------------------------------------------
# auto   = Claude if ANTHROPIC_API_KEY is set, otherwise the rule-based baseline (no AI)
# claude = always Claude (fails clearly if no key)
# rules  = always the rule-based baseline
EXTRACTOR=auto

# Your own Anthropic API key. Usage is billed to your account by Anthropic.
# When set, the text of the email you process (and its PDF text) is sent to Anthropic.
ANTHROPIC_API_KEY=
# Default: the lowest-cost Claude model. Any Claude model id works, e.g. claude-sonnet-5-5 or claude-opus-5-5.
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Gmail (only for INBOX_MODE=gmail) -----------------------------------------
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json
# Gmail search that selects the conversations to read (at most 25). Default: a label you create in the test account.
# The whole inbox, without Google's own security emails: in:inbox -from:accounts.google.com
GMAIL_QUERY=label:orders-demo
# Map the address you send test emails FROM to a demo customer, then run `uv run inbox-to-order init-db --reset`.
# Example: EXTRA_CUSTOMER_SENDERS=PINE-RIDGE=my.test.sender@gmail.com,LAKESHORE=other.sender@gmail.com
EXTRA_CUSTOMER_SENDERS=

# --- Storage --------------------------------------------------------------------
# The app's own working state: proposals, revisions, processing log, audit trail
INBOX_TO_ORDER_DB=data/inbox_to_order.db
# The fictional order system ("Demo ERP") behind its MCP server
DEMO_ERP_DB=data/demo_erp.db
